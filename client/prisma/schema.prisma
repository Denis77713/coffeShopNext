generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  activationLink String
  isActivated    Boolean      @default(false)
  lastName       String
  password       String
  role           String       @default("user")
  GradeStar      GradeStar[]
  ProductPay     ProductPay[]
  token          Token?
}

model Token {
  userId       Int    @unique
  refreshToken String
  token        User   @relation(fields: [userId], references: [id])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  image    String
  page     String
  category String    @default("Shop")
  filters  Filter[]
  products Product[]
}

model SecondCategory {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  text    String    @default("")
  Product Product[]
}

model Product {
  id               Int             @id @default(autoincrement())
  name             String
  imageUrl         String
  price            String?
  best             String?
  weight           String?
  none             String
  drip             String
  categoryId       Int
  number           Int?            @default(5)
  secondCategoryId Int?
  text             String?
  GradeStar        GradeStar[]
  category         Category        @relation(fields: [categoryId], references: [id])
  secondCategory   SecondCategory? @relation(fields: [secondCategoryId], references: [id])
}

model imagesUrlProduct {
  id       Int    @id @default(autoincrement())
  imageURL String
}

model ProductPay {
  id         Int    @id @default(autoincrement())
  userId     Int
  productId  Int
  sum        Int
  status     String @default("Успешный заказ")
  num        Int
  developId  String @default("")
  name       String
  textStatus String @default("Успешный заказ")
  user       User   @relation(fields: [userId], references: [id])
}

model Filter {
  id       Int      @id @default(autoincrement())
  name     String
  value    String
  text     String
  filterId Int
  filter   Category @relation(fields: [filterId], references: [id])
}

model City {
  id        Int        @id @default(autoincrement())
  name      String
  locations Location[]
}

model Location {
  id          Int     @id @default(autoincrement())
  adress      String
  locatin     String
  time        String
  menu        String
  newIsOpen   Boolean
  newLocation String
  isWork      Boolean
  cityId      Int
  city        City    @relation(fields: [cityId], references: [id])
}

model Carousel {
  id    Int    @id @default(autoincrement())
  image String
}

model WhyUsList {
  id    Int    @id @default(autoincrement())
  text  String
  image String
  title String
}

model Contacts {
  id    Int    @id @default(autoincrement())
  email String
  text  String
}

model GradeStar {
  id         Int     @id @default(autoincrement())
  grade      Int
  comment    String?
  userAnonim Boolean
  productId  Int
  userId     Int?
  category   Product @relation(fields: [productId], references: [id])
  User       User?   @relation(fields: [userId], references: [id])
}
